# =============================================================================
# SmartEE Web — server environment template
# =============================================================================
# Copy to `.env` and fill in real values. `.env` is gitignored.
#
# Every variable here has a hard-coded fallback in code, so omitting any of
# them keeps the legacy dev defaults working. Set them in production to
# rotate credentials, point at a different DB / MQTT broker, etc.
# =============================================================================

# ---- Database --------------------------------------------------------------
# DB_TYPE selects the driver in server/index.js:
#   mssql        -> tedious-based pool (cross-platform, supports SQL auth)
#   msnodesqlv8  -> native driver (Windows only, supports Windows auth)
DB_TYPE=mssql

# SQL Server connection (used by server/db.js).
#
# Windows Auth (current dev default) — leave DB_USER blank:
#   DB_SERVER=INNOTUC01\SQLEXPRESS
#   DB_NAME=db_energy_oee
#   DB_TRUSTED=true
#
# SQL Auth (recommended for Linux / cloud production):
#   DB_SERVER=my-prod-sql.example.com
#   DB_NAME=db_energy_oee
#   DB_USER=smartee_app
#   DB_PASS=changeme
#   DB_TRUSTED=false
DB_SERVER=
DB_NAME=
DB_USER=
DB_PASS=
DB_TRUSTED=

# ---- MQTT broker -----------------------------------------------------------
# Used by both the server-side notifier worker and the
# authenticated /api/mqtt/config endpoint that the SPA calls.
# NEVER put MQTT_PASSWORD in client/public/config/app-config.json — it's
# served unauthenticated.
MQTT_MODE=cloud
MQTT_CLOUD_URL=wss://cloudtat.com:9001/mqtt
MQTT_ONSITE_URL=ws://localhost:9001/mqtt
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=30
MQTT_RECONNECT_MS=1000
MQTT_CONNECT_TIMEOUT_MS=30000

# ---- Web Push (VAPID) ------------------------------------------------------
# Generate once with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# PRIVATE KEY IS A SECRET — never commit or ship to the client.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---- Smart EE Notification (LINE relay) -----------------------------------
# channel='smart' ส่งผ่าน relay ของ smarteepro.com (ไม่ใช่ LINE Messaging API ตรง).
# ผู้ใช้กรอกแค่ Group ID + Pin ID; `pas` เป็นรหัส API กลางค่าเดียวทั้งระบบ (secret).
SMARTEE_NOTIFY_URL=https://smarteepro.com/notify/v4/api/linebot
SMARTEE_NOTIFY_PAS=

# ---- Worker ---------------------------------------------------------------
# Set to 'false' on the API process (index.js) when worker.js is deployed as
# a SEPARATE Windows service (NSSM) — otherwise NotifyLog rows get inserted
# twice. Set to 'true' only when running a single combined process (dev).
ENABLE_MQTT_WORKER=false

# ---- Misc -----------------------------------------------------------------
# dev (nodemon): PORT=3003  — avoids conflict with PM2 staging on 3002
# staging/production (PM2): PORT=3002
PORT=3003
NODE_ENV=development
