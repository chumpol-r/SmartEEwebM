# =============================================================================
# SmartEE Web — server environment template
# =============================================================================
# Copy to `.env` and fill in real values. `.env` is gitignored.
#
# Every variable here has a hard-coded fallback in code, so omitting any of
# them keeps the legacy dev defaults working. Set them in production to
# rotate credentials, point at a different DB / MQTT broker, etc.
# =============================================================================

# ---- Database --------------------------------------------------------------
# SQL Server connection (used by server/db.js).
#
# Windows Auth (current dev default) — leave DB_USER blank:
#   DB_SERVER=INNOTUC01\SQLEXPRESS
#   DB_NAME=db_energy_oee
#   DB_TRUSTED=true
#
# SQL Auth (recommended for Linux / cloud production):
#   DB_SERVER=my-prod-sql.example.com
#   DB_NAME=db_energy_oee
#   DB_USER=smartee_app
#   DB_PASS=changeme
#   DB_TRUSTED=false
DB_SERVER=
DB_NAME=
DB_USER=
DB_PASS=
DB_TRUSTED=

# ---- MQTT broker -----------------------------------------------------------
# Used by both the server-side notifier worker and the
# authenticated /api/mqtt/config endpoint that the SPA calls.
# NEVER put MQTT_PASSWORD in client/public/config/app-config.json — it's
# served unauthenticated.
MQTT_MODE=cloud
MQTT_CLOUD_URL=wss://cloudtat.com:9001/mqtt
MQTT_ONSITE_URL=ws://localhost:9001/mqtt
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=30
MQTT_RECONNECT_MS=1000
MQTT_CONNECT_TIMEOUT_MS=30000

# ---- Web Push (VAPID) ------------------------------------------------------
# Generate once with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# PRIVATE KEY IS A SECRET — never commit or ship to the client.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---- Worker ---------------------------------------------------------------
# Set to 'false' to skip the MQTT notifier on this instance (useful when
# running multiple API replicas behind a load balancer to avoid duplicate
# alarm rows).
ENABLE_MQTT_WORKER=true

# ---- Misc -----------------------------------------------------------------
PORT=3002
NODE_ENV=production
